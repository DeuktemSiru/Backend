                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "sellers",
                "pickup",
                "verify"
              ],
              "query": [
                {
                  "key": "code",
                  "value": "{{pickupCode}}"
                }
              ]
